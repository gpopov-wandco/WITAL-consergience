# WITALCO Guest Concierge: environment variables (Appendix A of docs/BUILD_PROMPT.md).
# Copy to .env (never committed) or let `concierge setup` generate it.
# Values here are placeholders. Real secrets never belong in git, logs, prompts or chat.

# Platform
GC_ENV=development
GC_DATABASE_URL=
GC_PUBLIC_BASE_URL=
GC_MASTER_KEYS=
GC_ACTIVE_KEY_ID=
GC_SIGNING_KEY=
GC_BACKUP_KEY=
GC_METRICS_TOKEN=
GC_OPERATOR_EMAIL=

# Language model
GC_LLM_PROVIDER=none
ANTHROPIC_API_KEY=
GC_LLM_MODEL_PRIMARY=claude-sonnet-5-5
GC_LLM_MODEL_FAILOVER=claude-sonnet-5
GC_LLM_MODEL_CHEAP=
GC_LLM_STRUCTURED_OUTPUTS=true
GC_LLM_TURN_TIMEOUT_S=25
GC_EVAL_BUDGET_USD=5

# WhatsApp Cloud API
GC_WA_GRAPH_VERSION=v26.0

# E-mail
GC_EMAIL_PROVIDER=resend
RESEND_API_KEY=
GC_EMAIL_FROM=
GC_SMTP_HOST=
GC_SMTP_PORT=587
GC_SMTP_USER=
GC_SMTP_PASSWORD=
GC_SMTP_STARTTLS=true

# Optional integrations
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RETELL_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
HUBSPOT_TOKEN=

# Logging, time zone, UTF-8
GC_LOG_LEVEL=INFO
GC_TZ_DEFAULT=Europe/Berlin
PYTHONUTF8=1
